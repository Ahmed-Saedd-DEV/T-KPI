# Copy this file to .env.production on the host computer.
# Use a long URL-safe password (letters and numbers) so DATABASE_URL stays valid.
POSTGRES_DB=talabat_kpi
POSTGRES_USER=talabat_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgresql://talabat_user:REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD@postgres:5432/talabat_kpi?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
CORS_ORIGINS=https://YOUR-PROJECT.pages.dev
